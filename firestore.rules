rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn() && request.auth.token.email == 'mohammed.soft7@gmail.com';
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && (bootstrapAdmin() || userProfile().role == role);
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isParent() {
      return hasRole('parent');
    }

    function isStudent() {
      return hasRole('student');
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function setupDocExists() {
      return exists(/databases/$(database)/documents/school_settings/general_info);
    }

    function setupCompleted() {
      return setupDocExists() &&
        get(/databases/$(database)/documents/school_settings/general_info).data.setup_completed == true;
    }

    function hasStudent(studentId) {
      return isStudent() && request.auth.uid == studentId;
    }

    function parentLinkedTo(studentId) {
      return isParent() && exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.parentId == request.auth.uid;
    }

    function teacherLinkedToClass(classId) {
      return isTeacher() && exists(/databases/$(database)/documents/classes/$(classId)) &&
        (
          get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/classes/$(classId)).data.keys().hasAny(['teacherIds']) &&
            request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds
          )
        );
    }

    function behaviorStudentUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total_points', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'student' &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /custom_fields_schema/{fieldId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /school_settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || hasStudent(studentId) || parentLinkedTo(studentId) ||
        (isTeacher() && resource.data.classId is string && teacherLinkedToClass(resource.data.classId));
      allow create, delete: if isAdmin() && setupCompleted();
      allow update: if (isAdmin() && setupCompleted()) ||
        (isTeacher() && behaviorStudentUpdateOnly() && resource.data.classId is string && teacherLinkedToClass(resource.data.classId));
    }

    match /parents/{parentId} {
      allow read: if isAdmin() || isOwner(parentId) || isTeacher();
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (isTeacher() && setupCompleted());
    }

    match /annual_plans/{planId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() ||
        hasStudent(resource.data.studentId) ||
        parentLinkedTo(resource.data.studentId) ||
        teacherLinkedToClass(resource.data.classId);
      allow create: if isAdmin() || teacherLinkedToClass(request.resource.data.classId);
      allow update, delete: if isAdmin() || teacherLinkedToClass(resource.data.classId);
    }

    match /grades/{gradeId} {
      allow read: if isAdmin() ||
        hasStudent(resource.data.studentId) ||
        parentLinkedTo(resource.data.studentId) ||
        isTeacher();
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /fees/{feeId} {
      allow read: if isAdmin() || hasStudent(resource.data.studentId) || parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid;
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update, delete: if isAdmin() || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid;
    }

    match /admission_applications/{applicationId} {
      allow read, write: if isAdmin();

      match /documents/{documentId} {
        allow read, write: if isAdmin();
      }
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /borrowing_records/{recordId} {
      allow read: if isAdmin() || hasStudent(resource.data.studentId) || parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }

    match /academic_alerts/{alertId} {
      allow read: if isAdmin() || isTeacher() || hasStudent(resource.data.studentId) || parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin() || isTeacher();
    }

    match /staff/{staffId} {
      allow read, write: if isAdmin();
    }

    match /leaves/{leaveId} {
      allow read: if isAdmin() || resource.data.teacherId == request.auth.uid || resource.data.staffId == request.auth.uid;
      allow create: if isAdmin() || request.resource.data.teacherId == request.auth.uid || request.resource.data.staffId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /salary_slips/{slipId} {
      allow read: if isAdmin() || resource.data.teacherId == request.auth.uid || resource.data.staffId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /buildings/{buildingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /bed_allocations/{allocationId} {
      allow read: if isAdmin() || hasStudent(resource.data.studentId) || parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin() || resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin();
    }

    match /notification_outbox/{notificationId} {
      allow read: if isAdmin() || resource.data.recipient_id == request.auth.uid;
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /rewards/{rewardId} {
      allow read: if isAdmin() || isTeacher() || hasStudent(resource.data.studentId) || parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin() || isTeacher();
    }

    match /behavior_logs/{logId} {
      allow read: if isAdmin() || isTeacher() ||
        hasStudent(resource.data.student_id) ||
        parentLinkedTo(resource.data.student_id);
      allow create: if isAdmin() ||
        (isTeacher() &&
          request.resource.data.teacher_id == request.auth.uid &&
          request.resource.data.student_id is string &&
          exists(/databases/$(database)/documents/students/$(request.resource.data.student_id)) &&
          teacherLinkedToClass(get(/databases/$(database)/documents/students/$(request.resource.data.student_id)).data.classId));
      allow update, delete: if isAdmin();
    }

    match /assessment_types/{assessmentTypeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /subject_weights/{subjectWeightId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /timeslots/{timeslotId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teacherAvailability/{availabilityId} {
      allow read: if signedIn();
      allow write: if isAdmin() || resource.data.teacherId == request.auth.uid;
      allow create: if isAdmin() || request.resource.data.teacherId == request.auth.uid;
    }

    // ── NEW COLLECTIONS ─────────────────────────────────────────────

    match /calendar_events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /exam_schedule/{examId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /clinic_visits/{visitId} {
      allow read: if isAdmin() ||
        hasStudent(resource.data.studentId) ||
        parentLinkedTo(resource.data.studentId);
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /health_records/{recordId} {
      allow read: if isAdmin() ||
        hasStudent(resource.data.studentId) ||
        parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }

    match /discounts/{discountId} {
      allow read: if isAdmin() ||
        hasStudent(resource.data.studentId) ||
        parentLinkedTo(resource.data.studentId);
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
